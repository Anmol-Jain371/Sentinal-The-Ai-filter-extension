# ==============================================================================
# SentinelX .gitignore
# Prevents sensitive credentials, environment files, runtime artifacts, & caches
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit real .env files)
.env
.env.*
*.env
!.env.example

# Local credentials & keys
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519

# Python artifacts & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Test Caches
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & local state
*.db
*.sqlite
*.sqlite3
sentinelx.db

# Logs & Temporary Files
*.log
*.tmp
*.temp
scratch/
text

# Node / Frontend (if installed locally)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE, Editor, & OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
